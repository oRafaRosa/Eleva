{
  "expo": {
    "name": "ELEVA the club",
    "slug": "eleva",
    "version": "0.1.0",
    "scheme": "eleva",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/favicon.png",
      "output": "single",
      "name": "ELEVA the club",
      "shortName": "ELEVA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eleva.club"
    },
    "android": {
      "package": "com.eleva.club"
    },
    "plugins": ["expo-router", "expo-font"]
  }
}
